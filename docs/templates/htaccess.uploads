# Salin sebagai htdocs/uploads/.htaccess  (milik BACKEND) — upload publik, tanpa eksekusi script
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|php\d|phar|pl|py|cgi|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
